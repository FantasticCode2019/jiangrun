# ./dev.sh init 会自动生成 .env.development.local；通常无需手工复制本文件。
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=change-me-for-local-development
DEV_POSTGRES_DB=jiangrun_dev
DEV_DB_PORT=5432

DEV_JWT_SECRET=change-me-to-at-least-32-random-characters
DEV_ADMIN_INITIAL_PASSWORD=ChangeMe123456
DEV_SERVER_PORT=8080
DEV_FRONTEND_PORT=3000
DEV_ADMIN_PORT=3001
DEV_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# 国内网络默认代理；仍会依据 go.sum 校验下载内容，可改为 direct。
DEV_GOPROXY=https://goproxy.cn,direct
