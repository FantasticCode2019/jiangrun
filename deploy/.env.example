# 复制为 .env 并按需修改，或直接运行 ./deploy.sh 自动生成
# cp .env.example .env

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=jiangrun

# 后端
JWT_SECRET=change-me-to-a-long-random-string
# 首次启动时创建的管理员初始密码（登录后请立即修改）
ADMIN_INITIAL_PASSWORD=admin123
# Gin 运行模式: debug / release（生产请用 release）
SERVER_MODE=release

# 浏览器跨域白名单：必须填写完整 HTTPS 源，多个值以逗号分隔，禁止 *
CORS_ALLOWED_ORIGINS=https://jiangrun.net,https://www.jiangrun.net

# 域名、TLS 证书目录（目录内必须有 fullchain.pem 与 privkey.pem）
DOMAIN=jiangrun.net
TLS_CERT_DIR=./certs

# 对外端口（Nginx 入口）
HTTP_PORT=80
HTTPS_PORT=443

# 前端反代到后端的地址（容器内部服务名，一般无需修改）
API_URL=http://server:8080
